<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Quotes microservice: its own process, its own database (InsuranceQuotes).
       It may reference BuildingBlocks and other services' *.Contracts projects, never their implementation. -->

  <PropertyGroup>
    <UserSecretsId>insurance-quotes-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Run by DatabaseMigrator at startup. -->
    <EmbeddedResource Include="Database\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\Insurance.BuildingBlocks\Insurance.BuildingBlocks.csproj" />
    <ProjectReference Include="..\Insurance.Quotes.Contracts\Insurance.Quotes.Contracts.csproj" />
    <ProjectReference Include="..\..\Catalog\Insurance.Catalog.Contracts\Insurance.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Enrollments\Insurance.Enrollments.Contracts\Insurance.Enrollments.Contracts.csproj" />
  </ItemGroup>

</Project>
